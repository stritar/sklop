{
  "name": "sklop-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/tokens --filter ./packages/react run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "check:pack": "pnpm -r run check:pack",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm check:pack",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.5.1",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
