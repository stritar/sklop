{
  "name": "@sklop/react",
  "version": "0.0.2",
  "description": "An AI-native React component library.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ai",
    "css-modules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stritar/sklop.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry.json": "./registry/registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "registry"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-dist.mjs && node scripts/build-registry.mjs && node scripts/check-manifests.mjs && node scripts/generate-component-tokens.mjs --check",
    "generate:component-tokens": "node scripts/generate-component-tokens.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json",
    "check:pack": "publint && pnpm pack --out node_modules/.pack/react.tgz && attw node_modules/.pack/react.tgz --profile esm-only"
  },
  "dependencies": {
    "@sklop/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
