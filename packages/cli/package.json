{
  "name": "@sklop/cli",
  "version": "0.0.0",
  "description": "Copy Sklop components into your app to own them.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stritar/sklop.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sklop": "./bin/sklop.mjs"
  },
  "exports": {
    ".": "./src/add.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "true",
    "check:pack": "publint"
  }
}
