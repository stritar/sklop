{
  "$description": "PLACEHOLDER seed. Roles are provisional until the Figma import.",
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{color.neutral.0000}",
        "$extensions": { "sk.modes": { "dark": "{color.neutral.1100}" } }
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.0100}",
        "$extensions": { "sk.modes": { "dark": "{color.neutral.1000}" } }
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.1100}",
        "$extensions": { "sk.modes": { "dark": "{color.neutral.0000}" } }
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.0700}",
        "$extensions": { "sk.modes": { "dark": "{color.neutral.0400}" } }
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.neutral.0000}",
        "$extensions": { "sk.modes": { "dark": "{color.neutral.1100}" } }
      }
    },
    "fill": {
      "accent": {
        "$type": "color",
        "$value": "{color.accent.0600}",
        "$extensions": { "sk.modes": { "dark": "{color.accent.0400}" } }
      }
    },
    "border": {
      "focus": {
        "$type": "color",
        "$value": "{color.accent.0600}",
        "$extensions": { "sk.modes": { "dark": "{color.accent.0400}" } }
      }
    }
  },
  "space": {
    "inset": {
      "control": { "$type": "dimension", "$value": "{space.0400}" },
      "label": { "$type": "dimension", "$value": "{space.0200}" }
    },
    "gap": {
      "stack": { "$type": "dimension", "$value": "{space.0200}" }
    }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "{radius.0200}" }
  },
  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": "{font.family.sans}" }
    },
    "size": {
      "control": { "$type": "dimension", "$value": "{font.size.0100}" }
    },
    "weight": {
      "control": { "$type": "fontWeight", "$value": "{font.weight.0500}" }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "{motion.duration.0100}",
        "$extensions": { "sk.modes": { "reduced": "{motion.duration.0000}" } }
      },
      "normal": {
        "$type": "duration",
        "$value": "{motion.duration.0200}",
        "$extensions": { "sk.modes": { "reduced": "{motion.duration.0000}" } }
      }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "{motion.easing.decelerate}" }
    }
  }
}
